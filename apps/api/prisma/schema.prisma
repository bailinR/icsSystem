generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
  MANAGER
  FINANCE
  CC
}

enum ApplicationStatus {
  DRAFT
  PENDING_MANAGER
  MANAGER_REJECTED
  PENDING_FINANCE
  FINANCE_REJECTED
  APPROVED
  WITHDRAWN
}

enum ApprovalNode {
  MANAGER
  FINANCE
}

enum TaskStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ActionType {
  CREATED
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  WITHDRAWN
}

enum FileCategory {
  CHAT_RECORD
  VOUCHER
  CONTRACT
  OTHER
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String              @unique
  name              String
  passwordHash      String
  role              Role
  isActive          Boolean             @default(true)
  managerId         Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  manager           User?               @relation("UserManager", fields: [managerId], references: [id])
  reports           User[]              @relation("UserManager")
  applications      Application[]       @relation("ApplicantApplications")
  approvalTasks     ApprovalTask[]      @relation("ApproverTasks")
  approvalActions   ApprovalAction[]    @relation("ActorActions")
  notifications     Notification[]
}

model Application {
  id             Int                 @id @default(autoincrement())
  applicantId    Int
  influencerName String?             @db.VarChar(255)
  contact        String?             @db.VarChar(255)
  amount         Decimal?            @db.Decimal(12, 2)
  currency       String?             @db.VarChar(32)
  paymentMethod  String?             @db.VarChar(255)
  homepage       String?             @db.VarChar(1000)
  remark         String?             @db.Text
  status         ApplicationStatus   @default(DRAFT)
  approvalRound  Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  applicant      User                @relation("ApplicantApplications", fields: [applicantId], references: [id])
  files          ApplicationFile[]
  tasks          ApprovalTask[]
  actions        ApprovalAction[]

  @@index([applicantId])
  @@index([status])
}

model ApplicationFile {
  id            Int          @id @default(autoincrement())
  applicationId Int
  category      FileCategory
  originalName  String
  storedName    String
  mimeType      String
  size          Int
  path          String
  createdAt     DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApprovalTask {
  id            Int          @id @default(autoincrement())
  applicationId Int
  approverId    Int
  node          ApprovalNode
  round         Int
  status        TaskStatus   @default(PENDING)
  comment       String?      @db.Text
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approver      User         @relation("ApproverTasks", fields: [approverId], references: [id])

  @@index([approverId, status])
}

model ApprovalAction {
  id            Int          @id @default(autoincrement())
  applicationId Int
  actorId       Int
  action        ActionType
  node          ApprovalNode?
  round         Int
  comment       String?      @db.Text
  createdAt     DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor         User         @relation("ActorActions", fields: [actorId], references: [id])
}

model Notification {
  id            Int          @id @default(autoincrement())
  userId        Int
  applicationId Int?
  title         String
  body          String       @db.Text
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
